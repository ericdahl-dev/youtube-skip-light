{
  "manifest_version": 3,
  "name": "YouTube Skip Light",
  "version": "2.2",
  "description": "Physical ESP32 button that skips YouTube ads when one is on screen, and goes back a video when one is not.",
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "debugger"
  ],
  "host_permissions": [
    "http://192.168.0.81/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}